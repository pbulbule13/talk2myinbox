# Cognitive Journal Agent Configuration Template
# Copy this to .env and fill in your API keys

# ===================================================================
# CORE SETTINGS - Enable All Advanced Features
# ===================================================================

# LLM Settings
USE_LLM_PROCESSING=true
USE_LLM_REPORTING=true
LLM_PROVIDER=openai
LLM_MODEL_NAME=gpt-4o-mini
LLM_TEMPERATURE=0.3
AGENT_MODEL_NAME=gpt-4o-mini
AGENT_TEMPERATURE=0.2
AGENT_MAX_ITERATIONS=10
AGENT_VERBOSE=true

# Storage
STORAGE_BACKEND=json
STORAGE_DIR=./data

# TTS Settings
TTS_ENABLED=true
TTS_BACKEND=elevenlabs

# API Server
API_HOST=0.0.0.0
API_PORT=7000
API_RELOAD=false

# ===================================================================
# LLM CONFIGURATION - Add Your API Keys
# ===================================================================

# Euron API (Optional)
EURON_API_KEY=your_euron_api_key_here
EURON_API_BASE=https://api.euron.one/api/v1/euri
EURON_MODEL=gpt-4.1-nano

# DeepSeek API (Optional)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# Google Gemini (Optional)
GOOGLE_API_KEY=your_google_api_key_here

# OpenAI (Required for default setup)
OPENAI_API_KEY=your_openai_api_key_here

# Active Models
MODEL_NAME=gpt-4o-mini
TAB_QA_MODEL=gpt-4o-mini
RESPONSE_MODEL=gpt-4o-mini

# Fallback Models (comma-separated)
FALLBACK_MODELS=deepseek-chat,gemini-1.5-flash,gpt-4o-mini

# ===================================================================
# EMAIL CONFIGURATION (Optional)
# ===================================================================

# SMTP Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
FROM_EMAIL=your_email@gmail.com

# Gmail OAuth (Optional)
GMAIL_CLIENT_ID=your_gmail_client_id_here
GMAIL_CLIENT_SECRET=your_gmail_client_secret_here
GMAIL_REFRESH_TOKEN=your_gmail_refresh_token_here

# Voice Agent (Optional)
VOICE_AGENT_email_provider=gmail
VOICE_AGENT_voice_agent_name=Vinegar

# ===================================================================
# VOICE & TTS CONFIGURATION (Optional)
# ===================================================================

# ElevenLabs for Text-to-Speech
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_voice_id_here

# Google Calendar (Optional)
GOOGLE_CALENDAR_ENABLED=false

# ===================================================================
# DATABASE (Optional - for future use)
# ===================================================================

DATABASE_URL=postgresql://user:password@localhost:5432/journal_db
