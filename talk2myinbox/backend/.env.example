# Talk2MyInbox Environment Configuration
# Copy this file to .env and fill in your credentials

# ========================================
# Server Configuration
# ========================================
PORT=8000
HOST=0.0.0.0

# ========================================
# Gmail API Configuration (Optional)
# ========================================
# Get credentials from: https://console.cloud.google.com/apis/credentials
GMAIL_CLIENT_ID=your_gmail_client_id_here
GMAIL_CLIENT_SECRET=your_gmail_client_secret_here
GMAIL_REFRESH_TOKEN=your_gmail_refresh_token_here

# ========================================
# Google Calendar API Configuration (Optional)
# ========================================
# Uses same credentials as Gmail
CALENDAR_CLIENT_ID=your_calendar_client_id_here
CALENDAR_CLIENT_SECRET=your_calendar_client_secret_here
CALENDAR_REFRESH_TOKEN=your_calendar_refresh_token_here

# ========================================
# AI Provider Configuration (Optional)
# ========================================
# Euron API
EURON_API_KEY=your_euron_api_key_here
EURON_API_BASE=https://api.euron.one/api/v1/euri
EURON_MODEL=gpt-4.1-nano

# OpenAI (Fallback)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude (Fallback)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Gemini (Fallback)
GOOGLE_API_KEY=your_google_api_key_here

# ========================================
# Application Settings
# ========================================
# Mock mode (set to true to use sample data without real APIs)
USE_MOCK_MODE=false

# Log level
LOG_LEVEL=INFO

# ========================================
# NOTES
# ========================================
# - Application works in MOCK mode without any credentials
# - Mock mode shows sample emails and calendar events
# - For real Gmail/Calendar access, configure the API credentials above
# - Get Gmail OAuth credentials from: https://console.cloud.google.com
# - Follow the setup guide in: docs/SETUP.md
