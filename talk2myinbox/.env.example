# ============================================================================
# talk2myinbox - Environment Configuration Template
# ============================================================================
# IMPORTANT: Copy this file to .env and fill in your actual values
# NEVER commit .env to git - only commit this .env.example template
# ============================================================================

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
DEBUG_MODE=false

# ============================================================================
# AI/LLM PROVIDERS (Choose one or multiple for fallback)
# ============================================================================

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
# Example: sk-proj-abc123...xyz789

# Anthropic Claude Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Example: sk-ant-abc123...xyz789

# Google Gemini Configuration
GOOGLE_API_KEY=your_google_api_key_here
# Example: AIzaSy...abc123
# Get your key from: https://makersuite.google.com/app/apikey

# Euron AI Configuration (Cost-effective reasoning model)
EURON_API_KEY=your_euron_api_key_here
# Example: euri-abc123...xyz789
EURON_API_BASE=https://api.euron.one/api/v1/euri
EURON_MODEL=gpt-4.1-nano
# Get your key from: https://euron.one

# DeepSeek Configuration (Affordable fallback)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# Example: sk-abc123...xyz789
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
# Get your key from: https://platform.deepseek.com

# ============================================================================
# VOICE PROVIDER CONFIGURATION
# ============================================================================

# ElevenLabs (Text-to-Speech)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Example: sk_abc123...xyz789
# Get your key from: https://elevenlabs.io/app/settings

ELEVENLABS_VOICE_ID=your_voice_id_here
# Example: 21m00Tcm4TlvDq8ikWAM
# Get voice IDs from: https://elevenlabs.io/app/voice-library
# Default voices:
#   - 21m00Tcm4TlvDq8ikWAM (Rachel - Calm)
#   - 2qfp6zPuviqeCOZIE9RZ (Custom Voice)

# Voice Service Settings
TTS_PROVIDER=elevenlabs
STT_PROVIDER=whisper

# Voice Agent Settings
VOICE_AGENT_email_provider=gmail
VOICE_AGENT_voice_agent_name=Vinegar
AGENT_NAME=Communications Assistant

# ============================================================================
# GMAIL CONFIGURATION
# ============================================================================

# Gmail API Credentials (OAuth 2.0)
GMAIL_CREDENTIALS_PATH=./config/gmail_credentials.json
GMAIL_TOKEN_PATH=./config/gmail_token.json

# Gmail OAuth Client Credentials
# Get these from: https://console.cloud.google.com/apis/credentials
GMAIL_CLIENT_ID=your_gmail_client_id_here.apps.googleusercontent.com
# Example: 123456789-abc123xyz789.apps.googleusercontent.com

GMAIL_CLIENT_SECRET=your_gmail_client_secret_here
# Example: GOCSPX-abc123xyz789

GMAIL_REFRESH_TOKEN=your_gmail_refresh_token_here
# Example: 1//abc123xyz789...
# This is generated after OAuth flow

# Mock Mode (for testing without real Gmail)
EMAIL_MOCK_MODE=false
# Set to 'true' to use demo data instead of real Gmail

# ============================================================================
# GOOGLE CALENDAR CONFIGURATION
# ============================================================================

# Calendar API Credentials (OAuth 2.0)
CALENDAR_CREDENTIALS_PATH=./config/calendar_credentials.json
CALENDAR_TOKEN_PATH=./config/calendar_token.json

# Mock Mode (for testing without real Calendar)
CALENDAR_MOCK_MODE=false
# Set to 'true' to use demo data instead of real Calendar

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================

# User Configuration
DEFAULT_USER_ID=default_user

# ============================================================================
# QUICK START GUIDE
# ============================================================================
#
# 1. Copy this file to .env:
#    cp .env.example .env
#
# 2. Fill in your API keys:
#    - Get OpenAI key: https://platform.openai.com/api-keys
#    - Get Anthropic key: https://console.anthropic.com/
#    - Get ElevenLabs key: https://elevenlabs.io/app/settings
#    - Get Google API key: https://console.cloud.google.com/
#
# 3. For Gmail/Calendar OAuth:
#    - Create project: https://console.cloud.google.com/
#    - Enable Gmail API and Calendar API
#    - Create OAuth 2.0 credentials
#    - Download credentials JSON to config/
#
# 4. For testing without APIs:
#    - Set EMAIL_MOCK_MODE=true
#    - Set CALENDAR_MOCK_MODE=true
#
# 5. Run the application:
#    cd backend && python server.py
#
# ============================================================================
# SECURITY REMINDERS
# ============================================================================
#
# ⚠️  NEVER commit .env to git
# ⚠️  NEVER share your API keys
# ⚠️  NEVER put real keys in .env.example
# ✅  DO commit .env.example (with placeholders only)
# ✅  DO use environment variables in code
# ✅  DO rotate keys regularly
#
# ============================================================================
